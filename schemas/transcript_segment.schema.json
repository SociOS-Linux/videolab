{
  "$id": "socio.videolab.transcript_segment.v0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "videolab TranscriptSegment (v0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "media_ref",
    "start_ms",
    "end_ms",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "media_ref": {
      "type": "string",
      "minLength": 1
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "speaker": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "kind": {
      "type": "string",
      "enum": [
        "caption",
        "subtitle",
        "transcript",
        "translation"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
